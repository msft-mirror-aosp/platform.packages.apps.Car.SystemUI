<Controller id="grip_bar_controller">
    <ControllerName>com.android.systemui.car.wm.scalableui.view.GripBarViewController</ControllerName>
    <View>com.android.systemui.car.wm.scalableui.view.VerticalGripBar</View>
    <EventId>_Drag_PanelDragEvent</EventId>
    <Orientation>1</Orientation>
    <SnapThreadhold>20</SnapThreadhold>
    <BreakPoints>
        <BreakPoint point="50%" eventId="_Drag_PanelOpenEvent" />
        <BreakPoint point="100%" eventId="_Drag_PanelCloseEvent" />
    </BreakPoints>
</Controller>