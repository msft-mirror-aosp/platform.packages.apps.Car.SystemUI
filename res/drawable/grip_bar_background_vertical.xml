<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="?oemColorSurface"/>
            <corners android:topLeftRadius="?appPanelBackgroundRadius"
                android:bottomLeftRadius="?appPanelBackgroundRadius"
                android:topRightRadius="0dp"
                android:bottomRightRadius="0dp"/>
        </shape>
    </item>

    <item android:left="@dimen/panel_grip_bar_decor_top_margin"
        android:gravity="center_vertical|left">
        <shape>
            <corners android:radius="@dimen/panel_grip_bar_decor_corner_radius" />
            <size android:width="@dimen/panel_grip_bar_decor_height"
                android:height="@dimen/panel_grip_bar_decor_width" />
            <solid android:color="?oemColorSurfaceVariant" />
        </shape>
    </item>
</layer-list>
