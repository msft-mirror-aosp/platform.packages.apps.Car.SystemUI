android_library {
    name: "CarSystemUI-SystemBar-AssistantButton",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    static_libs: [
        "CarSystemUI-FlexibleUI",
        "CarSystemUI-Shared",
        "CarSystemUI-SystemBar-Base-Controller",
        "CarSystemUI-SystemBar-Base-View",
    ],
    plugins: [
        "dagger2-compiler",
    ],
}
