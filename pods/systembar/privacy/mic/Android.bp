package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_library {
    name: "CarSystemUI-SystemBar-PrivacyChip-Mic",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: [
        "CarSystemUI-FlexibleUI",
        "CarSystemUI-QC-Base",
        "CarSystemUI-QC-Footer-Base",
        "CarSystemUI-Shared",
        "CarSystemUI-SystemBar-Base-Controller",
        "CarSystemUI-SystemBar-Base-View",
        "CarSystemUI-SystemBar-PrivacyChip-Base",
        "CarSystemUI-SystemBar-Panel",
    ],
    plugins: [
        "dagger2-compiler",
    ],
    optimize: {
        proguard_flags_files: [
            "proguard.flags",
        ],
    },
    manifest: "AndroidManifest.xml",
}
