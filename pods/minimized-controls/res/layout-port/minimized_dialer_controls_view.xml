<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingHorizontal="@dimen/minimized_controls_button_padding"
    android:paddingTop="@dimen/minimized_controls_button_padding">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="@dimen/minimized_controls_button_padding"
        android:background="@drawable/minimized_controls_background">

        <!-- Section 1: Contact Image and App Icon -->
        <FrameLayout
            android:id="@+id/dialer_profile_container"
            android:layout_width="@dimen/minimized_controls_album_art_size"
            android:layout_height="@dimen/minimized_controls_album_art_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/dialer_contact_image"
                    android:layout_width="@dimen/minimized_controls_button_size"
                    android:layout_height="@dimen/minimized_controls_button_size"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:background="@drawable/minimized_dialer_contact_image_background"
                    android:clipToOutline="true"
                    android:src="@android:drawable/sym_contact_card" />

                <FrameLayout
                    android:layout_width="@dimen/minimized_controls_app_icon_size"
                    android:layout_height="@dimen/minimized_controls_app_icon_size"
                    android:layout_gravity="bottom|end"
                    android:translationX="@dimen/minimized_controls_app_icon_offset"
                    android:translationY="@dimen/minimized_controls_app_icon_offset"
                    android:background="@drawable/minimized_controls_app_icon_background">
                    <ImageView
                        android:id="@+id/dialer_app_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/minimized_controls_app_icon_outline_thickness"
                        android:scaleType="fitCenter"
                        android:background="@drawable/minimized_dialer_app_icon_mask"
                        android:clipToOutline="true"
                        android:src="@android:drawable/sym_def_app_icon" />
                </FrameLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- Section 2: Placeholder text that pushes buttons to the right (like media title) -->
        <TextView
            android:id="@+id/dialer_display_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/minimized_controls_button_padding"
            android:layout_marginEnd="@dimen/minimized_controls_button_padding"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAppearance="?oemTextAppearanceTitleLarge"
            app:layout_constraintStart_toEndOf="@id/dialer_profile_container"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/dialer_mute_container"
            app:layout_constraintBottom_toTopOf="@id/dialer_duration"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintHorizontal_bias="0.0"/>

        <Chronometer
            android:id="@+id/dialer_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/minimized_controls_button_padding"
            android:layout_marginEnd="@dimen/minimized_controls_button_padding"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAppearance="?oemTextAppearanceTitleMedium"
            app:layout_constraintStart_toEndOf="@id/dialer_profile_container"
            app:layout_constraintTop_toBottomOf="@id/dialer_display_name"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/dialer_mute_container"
            app:layout_constraintHorizontal_bias="0.0"/>

        <!-- Section 3: Rightmost buttons -->
        <!-- Keypad Button (Rightmost) -->
        <FrameLayout
            android:id="@+id/dialer_dialpad_container"
            android:layout_width="@dimen/minimized_controls_button_size"
            android:layout_height="@dimen/minimized_controls_button_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageButton
                android:id="@+id/dialer_dialpad_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:padding="@dimen/minimized_controls_icon_padding"
                android:background="@drawable/minimized_dialer_button_background"
                android:src="@drawable/minimized_dialer_ic_dialpad"
                android:contentDescription="@string/minimized_dialer_keypad_description" />
        </FrameLayout>

        <!-- End Call Button (Middle of the 3 buttons) -->
        <FrameLayout
            android:id="@+id/dialer_end_call_container"
            android:layout_width="@dimen/minimized_controls_button_size"
            android:layout_height="@dimen/minimized_controls_button_size"
            android:layout_marginEnd="@dimen/minimized_controls_button_padding"
            app:layout_constraintEnd_toStartOf="@id/dialer_dialpad_container"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageButton
                android:id="@+id/dialer_end_call_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:padding="@dimen/minimized_controls_icon_padding"
                android:background="@drawable/minimized_dialer_end_call_background"
                android:src="@drawable/minimized_dialer_ic_call_end"
                android:contentDescription="@string/minimized_dialer_end_call_description" />
        </FrameLayout>

        <!-- Mute Button (Leftmost of the 3 buttons) -->
        <FrameLayout
            android:id="@+id/dialer_mute_container"
            android:layout_width="@dimen/minimized_controls_button_size"
            android:layout_height="@dimen/minimized_controls_button_size"
            android:layout_marginEnd="@dimen/minimized_controls_button_padding"
            app:layout_constraintEnd_toStartOf="@id/dialer_end_call_container"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageButton
                android:id="@+id/dialer_mute_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:padding="@dimen/minimized_controls_icon_padding"
                android:background="@drawable/minimized_dialer_button_background"
                android:src="@drawable/minimized_dialer_ic_mic_on"
                android:contentDescription="@string/minimized_dialer_mute_description" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
