<TaskPanel id="map_panel" defaultVariant="@id/opened" displayId="0" controller="@xml/map_panel_controller">
    <Restart policy="LAST" maxRetry="3"/>
    <TaskBehavior taskProperties="UNTRIMMABLE"/>

    <Variant id="@+id/base">
        <Layer layer="@integer/map_panel_layer"/>
        <Focus onTransition="false" />
    </Variant>

    <Variant id="@+id/opened" parent="@id/base">
        <Visibility isVisible="true"/>
        <Bounds left="0" top="0" width="100%" bottom="100%" bottomOffset="@dimen/map_bottom_offset" />
        <Insets left="0" top="@dimen/status_bar_height" right="0" bottom="@dimen/map_bottom_inset" />
    </Variant>

    <Variant id="@+id/opened_overlap_app_grid" parent="@id/base">
        <Visibility isVisible="true"/>
        <Bounds left="0" top="0" width="100%" bottom="100%" bottomOffset="@dimen/map_bottom_offset" />
        <Insets left="0" top="@dimen/status_bar_height" right="0" bottom="@dimen/map_bottom_inset_large" />
    </Variant>

    <Variant id="@+id/closed" parent="@id/opened">
        <Visibility isVisible="false"/>
    </Variant>

    <Variant id="@+id/suw" parent="@id/closed" />
    <Variant id="@+id/userswitch" parent="@id/closed" />
    <Variant id="@+id/camera_opened" parent="@id/closed" />
    <Variant id="@+id/keyguard_opened" parent="@id/closed" />

    <Variant id="@+id/camera_appgrid" parent="@id/opened_overlap_app_grid">
        <Visibility isVisible="false"/>
    </Variant>

    <Transitions>

        <!-- Home -->
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/opened_overlap_app_grid" toVariant="@id/opened"/>

        <!-- Calm Mode -->
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_calm_mode" toVariant="@id/opened"/>

        <!-- App panel -->
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=app_panel" fromVariant="@id/opened" toVariant="@id/opened_overlap_app_grid"/>
        <Transition onEvent="_Drag_PanelCloseEvent" onEventTokens="panelId=decor_grip" fromVariant="@id/opened_overlap_app_grid" toVariant="@id/opened"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=app_panel" fromVariant="@id/opened_overlap_app_grid" toVariant="@id/opened"/>

        <!-- App grid panel -->
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/opened" toVariant="@id/opened_overlap_app_grid"/>
        <Transition onEvent="_Drag_PanelCloseEvent" onEventTokens="panelId=decor_grip_app" fromVariant="@id/opened_overlap_app_grid" toVariant="@id/opened"/>
        <Transition onEvent="close_app_grid" fromVariant="@id/opened_overlap_app_grid" toVariant="@id/opened"/>

        <!-- Setup Wizard -->
        <Transition onEvent="_System_EnterSuwEvent" toVariant="@id/suw"/>
        <Transition onEvent="_System_ExitSuwEvent" fromVariant="@id/suw" toVariant="@id/opened"/>

        <!-- User Switch -->
        <Transition onEvent="_System_BeforeUserSwitch" toVariant="@id/userswitch"/>
        <Transition onEvent="_System_UserSwitchComplete" fromVariant="@id/userswitch" toVariant="@id/opened"/>

        <!-- Keyguard -->
        <Transition onEvent="_System_KeyguardShown" toVariant="@id/keyguard_opened"/>
        <Transition onEvent="_System_KeyguardHidden" fromVariant="@id/keyguard_opened" toVariant="@id/opened"/>

        <!-- Camera -->
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=camera_panel" fromVariant="@id/opened" toVariant="@id/camera_opened"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=camera_panel" fromVariant="@id/camera_opened" toVariant="@id/opened"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=camera_panel" fromVariant="@id/opened_overlap_app_grid" toVariant="@id/camera_appgrid"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=camera_panel" fromVariant="@id/camera_appgrid" toVariant="@id/opened_overlap_app_grid"/>

    </Transitions>
</TaskPanel>
