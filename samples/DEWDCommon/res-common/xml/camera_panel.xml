  <TaskPanel id="camera_panel" defaultVariant="@id/closed" displayId="0" controller="@xml/camera_panel_controller">
    <Variant id="@+id/base">
        <Layer layer="@integer/camera_panel_layer"/>
        <Bounds right="100%" top="0" width="30%" height="30%" />
    </Variant>
    <Variant id="@+id/opened" parent="@id/base">
        <Visibility isVisible="true"/>
    </Variant>
    <Variant id="@+id/closed" parent="@id/base">
        <Visibility isVisible="false"/>
    </Variant>

    <!-- Home event should not close camera during reverse so not handling home event here. -->
    <Transitions>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=camera_panel" toVariant="@id/opened"/>
        <Transition onEvent="_System_TaskPanelEmptyEvent" onEventTokens="panelId=camera_panel" toVariant="@id/closed"/>
    </Transitions>
</TaskPanel>
