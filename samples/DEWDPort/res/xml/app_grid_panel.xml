  <TaskPanel id="panel_app_grid" defaultVariant="@id/closed" controller="@xml/app_grid_panel_controller" displayId="0">
    <Variant id="@+id/base">
        <Layer layer="@integer/app_grid_panel_layer"/>
    </Variant>

    <Variant id="@+id/opened" parent="@id/base">
        <Visibility isVisible="true"/>
        <Bounds left="0" bottom="100%" width="100%" height="@dimen/app_height" bottomOffset="@dimen/app_bottom_offset"/>
    </Variant>

    <Variant id="@+id/closed" parent="@id/base">
        <Visibility isVisible="false"/>
        <Bounds left="0" top="100%" width="100%" height="@dimen/app_height"/>
    </Variant>

    <KeyFrameVariant id="@+id/drag" parent="@id/base">
        <KeyFrame frame="0" variant="@id/opened" />
        <KeyFrame frame="100" variant="@id/closed" />
    </KeyFrameVariant>

    <Transitions>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/closed" toVariant="@id/opened"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=app_panel" toVariant="@id/closed"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_calm_mode" toVariant="@id/closed"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=suw_panel" toVariant="@id/closed"/>

        <Transition onEvent="_System_BeforeUserSwitch" fromVariant="@id/opened" toVariant="@id/closed"/>

        <Transition onEvent="_System_OnHomeEvent" toVariant="@id/closed"/>

        <Transition onEvent="_System_EnterSuwEvent" toVariant="@id/closed"/>
        <Transition onEvent="_System_ExitSuwEvent" toVariant="@id/closed"/>

        <Transition onEvent="close_app_grid" toVariant="@id/closed"/>

        <!-- Drag -->

        <Transition toVariant="@id/drag">
            <Event id="_Drag_PanelDragEvent" panelId="decor_grip_app" />
        </Transition>
        <Transition toVariant="@id/closed">
            <Event id="_Drag_PanelCloseEvent" panelId="decor_grip_app" />
        </Transition>
        <Transition toVariant="@id/opened">
            <Event id="_Drag_PanelOpenEvent" panelId="decor_grip_app" />
        </Transition>

    </Transitions>
</TaskPanel>