  <TaskPanel id="map_panel" defaultVariant="@id/opened" displayId="0" controller="@xml/map_panel_controller">
    <Variant id="@+id/base">
        <Layer layer="2"/>
        <Bounds
            left="@dimen/widget_panel_width"
            top="0"
            topOffset="@*android:dimen/status_bar_height"
            bottom="100%"
            bottomOffset="@*android:dimen/navigation_bar_height"
            right="100%" />
        <Corner radius="@dimen/map_corner_radius" />
    </Variant>
    <Variant id="@+id/opened" parent="@id/base">
        <Visibility isVisible="true"/>
    </Variant>
    <Variant id="@+id/closed" parent="@id/base">
        <Visibility isVisible="false"/>
    </Variant>

    <Transitions>
        <Transition onEvent="_System_EnterSuwEvent" toVariant="@id/closed"/>
        <Transition onEvent="_System_OnHomeEvent" toVariant="@id/closed"/>
        <Transition onEvent="_System_ExitSuwEvent" toVariant="@id/opened"/>
        <Transition onEvent="_System_OnHomeEvent" toVariant="@id/opened"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=app_panel" toVariant="@id/closed"/>
    </Transitions>
</TaskPanel>