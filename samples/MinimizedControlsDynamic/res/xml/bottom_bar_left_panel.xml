<SystemBar id="bottom_bar_left_panel" defaultVariant="@id/open" barZOrder="10" type="navigation" hideForKeyboard="true">
    <Variant id="@+id/base">
        <Bounds
            left="0"
            bottom="100%"
            width="@dimen/car_bottom_left_system_bar_width"
            height="@dimen/navigation_bar_height"/>
    </Variant>
    <Variant id="@+id/open" parent="@id/base">
        <Visibility isVisible="true"/>
    </Variant>
    <Variant id="@+id/closed" parent="@id/base">
        <Visibility isVisible="false"/>
    </Variant>
    <Transitions>
        <Transition onEvent="_System_Show_Panel" onEventTokens="panelId=bottom_bar_left_panel" toVariant="@id/open"/>
        <Transition onEvent="_System_Hide_Panel" onEventTokens="panelId=bottom_bar_left_panel" toVariant="@id/closed"/>
    </Transitions>
</SystemBar>