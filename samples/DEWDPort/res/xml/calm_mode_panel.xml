  <TaskPanel id="panel_calm_mode" defaultVariant="@id/closed" controller="@xml/calm_mode_panel_controller" displayId="0">
    <Variant id="@+id/base">
        <Layer layer="@integer/calm_mode_panel_layer"/>
    </Variant>
    <Variant id="@+id/opened" parent="@id/base">
        <Bounds left="0" top="0" width="100%" bottom="100%" bottomOffset="@dimen/navigation_bar_height" />
    </Variant>
    <Variant id="@+id/closed" parent="@id/base">
        <Visibility isVisible="false"/>
        <Bounds left="0" top="100%" width="100%" height="100%" topOffset="@dimen/navigation_bar_height"/>
    </Variant>
    <Variant id="@+id/suw" parent="@id/closed" />

    <Transitions>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_calm_mode" fromVariant="@id/closed" toVariant="@id/opened"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/opened" toVariant="@id/closed"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=app_panel" fromVariant="@id/opened" toVariant="@id/closed"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=suw_panel" fromVariant="@id/opened" toVariant="@id/closed"/>

        <Transition onEvent="_System_BeforeUserSwitch" fromVariant="@id/opened" toVariant="@id/closed"/>
        <Transition onEvent="_System_TaskCloseEvent" onEventTokens="panelId=panel_calm_mode" fromVariant="@id/opened" toVariant="@id/closed"/>

        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/opened" toVariant="@id/closed"/>

        <Transition onEvent="_System_EnterSuwEvent" toVariant="@id/suw"/>
        <Transition onEvent="_System_ExitSuwEvent" fromVariant="@id/suw" toVariant="@id/closed"/>
    </Transitions>
</TaskPanel>