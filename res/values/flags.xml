<resources>
    <!-- Enable the scalableUI feature. -->
    <bool name="scalable_ui">true</bool>
    <!-- A flag to enable task focus within the Scalable UI. -->
    <bool name="scalable_ui_enable_task_focus">true</bool>
    <!-- Controls dispatching events when panel animation ends. -->
    <bool name="enable_animation_end_event">true</bool>
    <!-- Enables the Design Compose-based design for the Scalable UI. -->
    <bool name="scalable_ui_design_compose">true</bool>
    <!-- Controls enabling optional decor on the task panel. -->
    <bool name="enable_decor">true</bool>
    <!-- Ensures that automatically added decorations for compatibility mode respect the panel's safe region. -->
    <bool name="display_compatibility_auto_decor_safe_region">true</bool>
    <!-- Controls restarting the task automatically when it is removed by the shell. -->
    <bool name="scalable_ui_task_auto_restart">true</bool>
    <!-- Enables actions within the Scalable UI. -->
    <bool name="scalable_ui_actions">true</bool>
    <!-- Controls registering to PanelUpdates Consumer. -->
    <bool name="enable_ext_panel_updates">true</bool>
    <!-- Controls enabling task focus for ScalableUI. -->
    <bool name="scalable_ui_task_focus">true</bool>
    <!-- Controls enabling applicable display filtering for ScalableUI. -->
    <bool name="scalable_ui_applicable_displays">true</bool>
</resources>
