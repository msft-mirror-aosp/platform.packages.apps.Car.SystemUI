  <TaskPanel id="panel_app_styled_view" defaultVariant="@id/closed" displayId="0" controller="@xml/app_styled_view_panel_controller">
    <Variant id="@+id/base">
        <Layer layer="@integer/app_styled_view_panel_layer"/>
        <Bounds left="200dp" top="196dp" width="750dp" height="1000dp" topOffset="@dimen/app_safe_top_offset"  bottomOffset="@dimen/app_bottom_offset" />
    </Variant>
    <Variant id="@+id/opened" parent="@id/base">
    </Variant>
    <Variant id="@+id/closed" parent="@id/base">
        <Visibility isVisible="false"/>
    </Variant>

    <Transitions>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_styled_view" fromVariant="@id/closed" toVariant="@id/opened"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/opened" toVariant="@id/closed"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=app_panel" fromVariant="@id/opened" toVariant="@id/closed"/>
        <Transition onEvent="_System_TaskCloseEvent" onEventTokens="panelId=panel_app_styled_view" toVariant="@id/closed"/>
        <Transition onEvent="_System_OnHomeEvent" toVariant="@id/closed"/>
        <Transition onEvent="_AppStyleView_CloseEvent" fromVariant="@id/opened" toVariant="@id/closed"/>
    </Transitions>
</TaskPanel>
