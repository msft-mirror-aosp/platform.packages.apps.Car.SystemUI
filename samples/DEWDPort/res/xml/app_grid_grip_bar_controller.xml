<Controller id="app_grid_grip_bar_controller">
    <ControllerName>com.android.systemui.car.wm.scalableui.view.GripBarViewController</ControllerName>
    <View>com.android.systemui.car.wm.scalableui.view.HorizontalGripBar</View>
    <EventId>_Drag_PanelDragEvent</EventId>
    <Orientation>0</Orientation>
    <SnapThreadhold>5</SnapThreadhold>
    <BreakPoints>
        <BreakPoint point="@dimen/app_top" eventId="_Drag_PanelOpenEvent" />
        <BreakPoint point="@dimen/screen_height" eventId="_Drag_PanelCloseEvent" />
    </BreakPoints>
</Controller>