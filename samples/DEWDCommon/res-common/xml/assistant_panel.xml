  <TaskPanel id="assistant_panel" defaultVariant="@id/closed" controller="@xml/assistant_panel_controller" displayId="0">
    <Variant id="@+id/base">
        <Layer layer="@integer/assistant_panel_layer"/>
        <Bounds left="0" top="0" right="100%" height="100%" />
    </Variant>
    <Variant id="@+id/opened" parent="@id/base">
        <Visibility isVisible="true"/>
    </Variant>
    <Variant id="@+id/closed" parent="@id/base">
        <Visibility isVisible="false"/>
    </Variant>

    <Transitions>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=assistant_panel" fromVariant="@id/closed" toVariant="@id/opened"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/opened" toVariant="@id/closed"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=app_panel" fromVariant="@id/opened" toVariant="@id/closed"/>
        <Transition onEvent="_System_TaskCloseEvent" onEventTokens="panelId=assistant_panel" toVariant="@id/closed"/>
        <Transition onEvent="_System_OnHomeEvent" toVariant="@id/closed"/>
        <Transition onEvent="_System_ExitSuwEvent" toVariant="@id/closed"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=suw_panel" toVariant="@id/closed"/>
        <Transition onEvent="_System_EnterSuwEvent" toVariant="@id/closed"/>

        <Transition onEvent="_System_BeforeUserSwitch" fromVariant="@id/opened" toVariant="@id/closed"/>
    </Transitions>
</TaskPanel>
