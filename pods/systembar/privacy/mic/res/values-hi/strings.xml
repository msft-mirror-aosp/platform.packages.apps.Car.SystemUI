    <string name="sensor_privacy_start_use_mic_dialog_content" msgid="231805443197748604">"जारी रखने के लिए, सूचना और मनोरंजन की सुविधा देने वाले डिवाइस के माइक्रोफ़ोन को चालू करें. ये उन सभी ऐप्लिकेशन के लिए, माइक्रोफ़ोन को चालू कर देगा जिन्हें अनुमति है."</string>
    <string name="system_bar_mic_privacy_chip" msgid="448357698821080133">"माइक प्राइवसी चिप"</string>
</resources>
