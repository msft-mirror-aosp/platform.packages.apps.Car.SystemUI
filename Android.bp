package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_system_experience",
}

genrule {
    name: "statslog-carsystemui-java-gen",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --java $(out) --module carsystemui" +
        " --javaPackage com.android.systemui --javaClass CarSystemUIStatsLog",
    out: ["com/android/systemui/car/CarSystemUIStatsLog.java"],
}

// List of files that need to be available in CarSystemUI-core
// Because they are
// - related to dagger initialization
// - depend on dagger components for initialization
filegroup {
    name: "CarSystemUI-application-srcs",
    srcs: [
        "src/**/*Module.java",
        "src/**/*Module.kt",
        "src/com/android/systemui/CarComponentBinder.java",
        "src/com/android/systemui/CarGlobalRootComponent.java",
        "src/com/android/systemui/CarSysUIComponent.java",
        "src/com/android/systemui/CarSysUIDisplaySubcomponent.kt",
        "src/com/android/systemui/CarSystemUIActivityBinder.java",
        "src/com/android/systemui/CarSystemUIAppComponentFactory.java",
        "src/com/android/systemui/CarSystemUIBinder.java",
        "src/com/android/systemui/CarSystemUIInitializer.java",
        "src/com/android/systemui/CarSystemUIServiceBinder.java",
        "src/com/android/systemui/car/userpicker/ActivityHelper.java",
        "src/com/android/systemui/car/userpicker/UserPickerActivity.java",
        "src/com/android/systemui/car/userpicker/UserPickerActivityComponent.java",
        "src/com/android/systemui/wmshell/CarWMComponent.java",
    ],
}

carsystemui_srcs = [
    "src/**/*.java",
    "src/**/*.kt",
    "src/**/I*.aidl",
    ":statslog-carsystemui-java-gen",
]

carsysui_pods = [
    // pods go here
    "CarSystemUI-Hvac-Controller",
    "CarSystemUI-Hvac-UI",
    "CarSystemUI-Minimized-Controls",
    "CarSystemUI-Notification",
    "CarSystemUI-QC-DataSubscription",
    "CarSystemUI-QC-Footer-Base",
    "CarSystemUI-QC-Base",
    "CarSystemUI-QC-Footer-Logout",
    "CarSystemUI-QC-Footer-ScreenOff",
    "CarSystemUI-QC-Footer-UserPicker",
    "CarSystemUI-QC-ProfileSwitcher",
    "CarSystemUI-StatusIcon-Base",
    "CarSystemUI-StatusIcon-Bluetooth",
    "CarSystemUI-StatusIcon-Location",
    "CarSystemUI-StatusIcon-MediaVolume",
    "CarSystemUI-StatusIcon-Mobile",
    "CarSystemUI-StatusIcon-PhoneCall",
    "CarSystemUI-StatusIcon-Connectivity",
    "CarSystemUI-StatusIcon-Wifi",
    "CarSystemUI-SystemBar-AaosStudioButton",
    "CarSystemUI-SystemBar-AppGridButton",
    "CarSystemUI-SystemBar-AssistantButton",
    "CarSystemUI-SystemBar-Base-Controller",
    "CarSystemUI-SystemBar-Base-View",
    "CarSystemUI-SystemBar-ControlCenterButton",
    "CarSystemUI-SystemBar-DebugPanel",
    "CarSystemUI-SystemBar-Dock",
    "CarSystemUI-SystemBar-Extension",
    "CarSystemUI-SystemBar-HomeButton",
    "CarSystemUI-SystemBar-NotificationChip",
    "CarSystemUI-SystemBar-Panel",
    "CarSystemUI-SystemBar-PassengerHomeButton",
    "CarSystemUI-SystemBar-PrivacyChip-Base",
    "CarSystemUI-SystemBar-PrivacyChip-Camera",
    "CarSystemUI-SystemBar-PrivacyChip-Cast",
    "CarSystemUI-SystemBar-PrivacyChip-Mic",
    "CarSystemUI-SystemBar-PrivacyChip-Share",
    "CarSystemUI-SystemBar-Standard",
    "CarSystemUI-SystemBar-Split",
    "CarSystemUI-SystemBar-UserNamePanel",
    "CarSystemUI-SystemBar-Volume",
]

java_defaults {
    name: "CarSystemUI-core-defaults",

    srcs: carsystemui_srcs,
    exclude_srcs: [
        ":CarSystemUI-application-srcs",
    ],

    resource_dirs: [
        "res-keyguard",
        "res",
    ],

    static_libs: [
        "CarSystemUI-FlexibleUI",
        "dewd-res-core",
        "SystemUI-application",
        "SystemUI-core",
        "CarNotificationLib",
        "SystemUIPluginLib",
        "SystemUISharedLib",
        "SettingsLib",
        "car-admin-ui-lib",
        "car-helper-lib",
        "car-telephony-common-no-overlayable",
        "car-ui-lib-no-overlayable",
        "car-qc-lib",
        "car-scalable-ui-lib",
        "car-scalable-ui-designcompose-lib",
        "car-tos-lib",
        "com_android_systemui_car_flags_lib",
        "androidx.annotation_annotation",
        "androidx.legacy_legacy-support-v4",
        "androidx.recyclerview_recyclerview",
        "androidx.preference_preference",
        "androidx.appcompat_appcompat",
        "androidx.mediarouter_mediarouter",
        "androidx.palette_palette",
        "androidx.legacy_legacy-preference-v14",
        "androidx.leanback_leanback",
        "androidx.slice_slice-core",
        "androidx.slice_slice-view",
        "androidx.slice_slice-builders",
        "androidx.arch.core_core-runtime",
        "androidx.lifecycle_lifecycle-common-java8",
        "androidx.lifecycle_lifecycle-extensions",
        "SystemUI-tags",
        "SystemUI-proto",
        "dagger2",
        "//external/kotlinc:kotlin-annotations",
        "//frameworks/libs/systemui:animationlib",
        "CarDockLib",
        "androidx.test.rules",
        "Car-WindowManager-Shell",
        "oem-token-lib",
    ],

    libs: [
        "android.car",
        "token-shared-lib-prebuilt",
    ],
    enforce_uses_libs: false,
}

android_library {
    name: "CarSystemUI-core",

    srcs: [
        ":CarSystemUI-application-srcs",
    ],

    resource_dirs: [],
    manifest: "AndroidManifest.xml",

    static_libs: [
        "CarSystemUI-Shared",
    ] + carsysui_pods,

    libs: [
        "android.car",
    ],
    enforce_uses_libs: false,

    javacflags: [
        "-Adagger.fastInit=enabled",
    ],

    kotlincflags: ["-J-Xmx16384M"],

    plugins: ["dagger2-compiler"],
}

android_library {
    name: "CarSystemUI-Shared",
    defaults: [
        "CarSystemUI-core-defaults",
    ],

    aaptflags: [
        "--no-resource-deduping",
    ],

    manifest: "AndroidManifest-shared.xml",

    javacflags: [
        "-Adagger.fastInit=enabled",
    ],

    plugins: ["dagger2-compiler"],
}

android_app {
    name: "CarSystemUI",

    defaults: [
        "wmshell_defaults",
    ],

    static_libs: [
        "CarSystemUI-core",
    ],

    export_package_resources: true,

    libs: [
        "android.car",
        "token-shared-lib-prebuilt",
    ],

    enforce_uses_libs: false,

    resource_dirs: [],

    overrides: [
        "SystemUI",
    ],

    platform_apis: true,
    system_ext_specific: true,
    certificate: "platform",
    privileged: true,

    optimize: {
        proguard_flags_files: [
            "proguard.flags",
        ],
        included_proguard_flags_files: [":sysui_proguard_common_and_kotlin"],
    },
    dxflags: ["--multi-dex"],

    aaptflags: [
        "--extra-packages",
        "com.android.keyguard",
    ],

    kotlincflags: ["-Xjvm-default=all"],

    plugins: ["dagger2-compiler"],

    required: [
        "privapp_whitelist_com.android.systemui",
        "allowed_privapp_com.android.carsystemui",
    ],
}

// Begin daggervis

// Dropped from google3/java/com/google/android/libraries/docs/inject/daggerplugin/dot
java_import_host {
    name: "car-systemui-binding-graph-plugin-jar",
    jars: ["daggervis/libdagger_binding_graph_plugin_lib.jar"],
}

// A java SPI plugin to visualize dagger dependency graph.
java_plugin {
    name: "car-systemui-binding-graph-plugin",
    static_libs: [
        "car-systemui-binding-graph-plugin-jar",
        "dagger2-compiler-lib",
        "auto_service_annotations",
        "auto_value_annotations",
        "auto_value_memoized_extension_annotations",
    ],
    processor_class: "dagger.internal.codegen.ComponentProcessor",
}

android_library {
    name: "CarSystemUI-core-daggervis",
    defaults: [
        "CarSystemUI-core-defaults",
    ],
    srcs: [
        ":CarSystemUI-application-srcs",
    ],
    manifest: "AndroidManifest-shared.xml",
    static_libs: carsysui_pods,
    plugins: [
        "car-systemui-binding-graph-plugin",
        "dagger2-compiler",
    ],
}

// End daggervis

android_library {
    name: "CarSystemUI-tests-base",
    manifest: "tests/AndroidManifest-base.xml",
    resource_dirs: [
        "tests/res",
        "res-keyguard",
        "res",
    ],
    static_libs: [
        "CarSystemUI-Shared",
        "SystemUI-tests-base",
        "CarNotificationLib",
        "android.car.test.utils",
        "car-admin-ui-lib",
        "car-helper-lib",
        "car-telephony-common-no-overlayable",
        "car-ui-lib-no-overlayable",
        "car-qc-lib",
        "car-scalable-ui-lib",
        "car-scalable-ui-designcompose-lib",
        "car-tos-lib",
        "com_android_systemui_car_flags_lib",
        "com_android_car_scalableui_flags_lib",
        "CarDockLib",
        "testng",
        "//external/kotlinc:kotlin-annotations",
        "Car-WindowManager-Shell",
        "oem-token-lib",
    ] + carsysui_pods,

    libs: [
        "token-shared-lib-prebuilt",
    ],
    enforce_uses_libs: false,
}

android_library {
    name: "CarSystemUI-tests",
    manifest: "tests/AndroidManifest-tests.xml",
    srcs: [
        "tests/src/**/*.java",
        "tests/src/**/*.kt",
        ":CarSystemUI-tests-multivalent",
        ":CarSystemUI-application-srcs",
    ],

    static_libs: [
        "SystemUI-tests",
        "CarSystemUI-tests-base",
    ],
    libs: [
        "android.test.runner.stubs.system",
        "android.test.base.stubs.system",
        "android.car",
        "token-shared-lib-prebuilt",
        "android.test.mock.stubs.system",
    ],

    enforce_uses_libs: false,

    aaptflags: [
        "--extra-packages",
        "com.android.systemui",
    ],

    plugins: ["dagger2-compiler"],

    lint: {
        test: true,
    },

    // TODO(b/218518451) re-enable errorprone.
    errorprone: {
        enabled: false,
    },
}

android_app {
    name: "CarSystemUIRobo-stub",
    defaults: [
        "platform_app_defaults",
        "SystemUI_optimized_defaults",
        "wmshell_defaults",
    ],
    manifest: "tests/AndroidManifest-base.xml",

    static_libs: [
        "//frameworks/libs/systemui:compilelib",
        "CarSystemUI-tests-base",
        "androidx.compose.runtime_runtime",
        "CarSystemUI-core",
    ],
    libs: [
        "keepanno-annotations",
        "android.car",
        "token-shared-lib-prebuilt",
    ],

    enforce_uses_libs: false,

    aaptflags: [
        "--extra-packages",
        "com.android.systemui",
    ],
    dont_merge_manifests: true,
    platform_apis: true,
    system_ext_specific: true,
    certificate: "platform",
    privileged: true,
    kotlincflags: ["-Xjvm-default=all"],
    optimize: {
        shrink_resources: false,
        optimized_shrink_resources: false,
        proguard_flags_files: ["proguard.flags"],
        included_proguard_flags_files: [":sysui_proguard_common_and_kotlin"],
    },

    plugins: ["dagger2-compiler"],
}

android_robolectric_test {
    name: "CarSystemUIRoboTests",
    srcs: [
        ":SystemUI-robotest-utils",
        ":CarSystemUI-tests-multivalent",
    ],
    static_libs: [
        "RoboTestLibraries",
        "SystemUI_test_fixtures",
    ],
    libs: [
        "android.car",
        "android.test.runner.impl",
        "android.test.base.impl",
        "android.test.mock.impl",
        "truth",
        "token-shared-lib-prebuilt",
    ],

    enforce_uses_libs: false,

    instrumentation_for: "CarSystemUIRobo-stub",
    java_resource_dirs: ["tests/robolectric/config"],
    plugins: [
        "dagger2-compiler",
    ],
    strict_mode: false,
}

android_ravenwood_test {
    name: "CarSystemUIRavenTests",
    srcs: [
        ":CarSystemUI-tests-multivalent",
    ],
    static_libs: [
        "CarSystemUI-core",
        "CarSystemUI-tests-base",
        "CarSystemUIRobo-stub",
        "androidx.compose.ui_ui-test-junit4",
        "androidx.test.uiautomator_uiautomator",
        "androidx.core_core-animation-testing",
        "androidx.test.ext.junit",
        "kosmos",
        "mockito-kotlin-nodeps",
        "SystemUI_test_fixtures",
    ],
    libs: [
        "android.car",
        "android.test.runner.stubs.system",
        "android.test.base.stubs.system",
        "android.test.mock.stubs.system",
        "token-shared-lib-prebuilt",
    ],

    enforce_uses_libs: false,
    auto_gen_config: true,
    plugins: [
        "dagger2-compiler",
    ],
}

filegroup {
    name: "CarSystemUI-tests-multivalent",
    srcs: [
        "multivalentTests/src/**/*.kt",
        "multivalentTests/src/**/*.java",
        "tests/utils/src/com/android/systemui/*.java",
    ],
}

filegroup {
    name: "CarSystemUI-proguard-deps",
    srcs: [
        "proguard.flags",
        ":sysui_proguard_common_and_kotlin",
    ],
}
